NODE_ENV=production
POSTGRES_PASSWORD=GENERATE_A_LONG_RANDOM_PASSWORD
DATABASE_URL=postgresql://atxcloud:GENERATE_A_LONG_RANDOM_PASSWORD@db:5432/atxcloud
ATXCLOUD_INTERNAL_SECRET=GENERATE_A_LONG_RANDOM_SECRET
ATXCLOUD_COOKIE_SECRET=GENERATE_A_64_BYTE_SECRET
DASHBOARD_URL=https://dash.atxcloud.ggff.net
NEXT_PUBLIC_API_URL=https://dash.atxcloud.ggff.net/api
API_URL=http://api:4000
PORT=4000
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://dash.atxcloud.ggff.net/auth/discord/callback
DISCORD_GUILD_ID=
STAFF_ROLE_IDS=
PTERODACTYL_URL=https://panel.atxcloud.ggff.net
PTERODACTYL_APPLICATION_KEY=
PTERODACTYL_CLIENT_KEY=

# Minecraft public-address bootstrap: AtxCloud only installs the plugin.
# It NEVER creates, claims, or configures a Playit tunnel/account for users.
ATXCLOUD_PLAYIT_PLUGIN_ENABLED=1
ATXCLOUD_PLAYIT_PLUGIN_URL=https://github.com/playit-cloud/playit-minecraft-plugin/releases/latest/download/playit-minecraft-plugin.jar
ATXCLOUD_PLAYIT_PLUGIN_FILENAME=playit-minecraft-plugin.jar
